# 只上传 Python 源码, 其余一律忽略(数据/文档/图/中间产物等)
# 规则: 先忽略一切, 再仅放行目录递归 + .py + 本文件

# 忽略所有
*

# 但允许进入子目录(否则 git 无法递归到 .py)
!*/

# 仅放行 Python 源码
!*.py

# 放行本忽略文件自身(使规则纳入版本控制)
!.gitignore

# 放行英文 CHANGELOG(需 push 到 GitLab 展示); 中文 chinese_change_log.md 仍被忽略(仅本地看)
!CHANGELOG.md

# 始终排除虚拟环境、IDE 与缓存(含其中的 .py / .gitignore)
.venv/
venv/
env/
__pycache__/
.tmp_pyc*/
.tmp_*/
.idea/
.vscode/

# 放行 notebooks(D84 提交)与项目说明文件
!*.ipynb
!README.md
!requirements.txt




# 放行最小可运行数据集(衍生数据; 原始 TD/TRUST/CIF 不入库)
!Derby_info.csv
!route_to_tc_all.csv
!platform_tc_map.csv
!platform_end_signals.csv
!artifacts/calib/*.json
!artifacts/subset/*.parquet
!artifacts/reports/*.json
!artifacts/reports/bc_fullpanel_gnn.pt
!artifacts/reports/ppo_push_AB_s0_best.pt
!artifacts/reports/ppo_d73_AB_s0_best.pt
!artifacts/reports/ppo_8192_anchor_s0_last.pt

# 放行最小可运行数据集(衍生数据; 原始 TD/TRUST/CIF 与 7GB dataset 不入库)
!Derby_info.csv
!route_to_tc_all.csv
!platform_tc_map.csv
!platform_end_signals.csv
!artifacts/calib/*.json
!artifacts/subset/*.parquet
!artifacts/reports/*.json
!artifacts/reports/bc_fullpanel_gnn.pt
!artifacts/reports/ppo_push_AB_s0_best.pt
!artifacts/reports/ppo_d73_AB_s0_best.pt
!artifacts/reports/ppo_8192_anchor_s0_last.pt

raw_data/Schedule.CIF
raw_data/Train_Describer_data.csv
